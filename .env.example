# ParkShare Environment Variables
# Copy this file to .env and fill in the actual values.
# NEVER commit the .env file to git.

# ─────────────────────────────────────────────
# DATABASE (leave empty for local H2 in-memory)
# ─────────────────────────────────────────────
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/parkshare_db
# SPRING_DATASOURCE_USERNAME=parkshare_user
# SPRING_DATASOURCE_PASSWORD=your_db_password
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
# HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# ─────────────────────────────────────────────
# JWT (generate a strong 256-bit hex secret for production)
# ─────────────────────────────────────────────
# JWT_SECRET=your_256_bit_hex_secret_here
# JWT_EXPIRATION_MS=86400000

# ─────────────────────────────────────────────
# CLOUDINARY (get from cloudinary.com dashboard)
# ─────────────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ─────────────────────────────────────────────
# RAZORPAY (get from dashboard.razorpay.com — use Test keys for development)
# Currency is INR (Razorpay India only)
# ─────────────────────────────────────────────
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ─────────────────────────────────────────────
# MISC
# ─────────────────────────────────────────────
# H2_CONSOLE_ENABLED=false  # Set to false in production
